{
  "manifest_version": 3,
  "name": "TidyFlow",
  "description": "Informa ao TidyFlow de onde veio cada download, para as regras organizarem o arquivo.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "TidyFlow",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png"
    }
  },
  "key": ""
}
